# ============================================================
# DavTeam Ruflos AI Agents — Environment Configuration
# ============================================================
# Copy this file to ".env" and fill in your values.
# NEVER commit the real .env file. It is gitignored.
# All provider credentials are SERVER-SIDE ONLY.
# The frontend never receives any of these values.
# ============================================================

# --- Server ---
# Port the DavTeam API listens on. Hugging Face requires 7860 by default.
PORT=7860
# Bind address — use 0.0.0.0 for Hugging Face / container reachability.
HOST=0.0.0.0

# --- Workspace ---
# The controlled filesystem directory agents/tools operate within.
# Path traversal outside this directory is blocked.
WORKSPACE=/workspace/davteam-workspace

# --- Model Provider (OpenAI-compatible) ---
# The backend proxies model requests through Ruflo's model routing.
# MODEL_API_KEY is server-side only and never sent to the browser.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o
MODEL_API_KEY=

# --- Ruflo provider groups ---
# Toggle which MCP tool groups are exposed. See upstream ruflo docs.
MCP_GROUP_AGENTS=true
MCP_GROUP_MEMORY=true
MCP_GROUP_DEVTOOLS=true
MCP_GROUP_SECURITY=false
MCP_GROUP_BROWSER=false
MCP_GROUP_NEURAL=false

# --- Optional upstream provider keys (server-side only) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Optional: DavTeam API auth token ---
# If set, the browser must send "Authorization: Bearer <token>".
# Leave empty for public/demo deployments.
DAVTEAM_API_TOKEN=

# --- Logging ---
LOG_LEVEL=info

# --- JEV Decision API (server-side plugin, TypeSafe AI) ---
# JEV provides typed AI decisions (choice/score/noul).
# Credentials are server-side only — never exposed to the browser.
# Docs: https://jev-agent.com/api-reference
JEV_API_KEY=
JEV_BASE_URL=https://jev-agent.com
